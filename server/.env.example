# Server Port Configuration
PORT=5000

# Razorpay Test Mode Credentials
# NEVER expose RAZORPAY_KEY_SECRET to frontend or git
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Razorpay Webhook Secret (Separate from Key Secret)
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# WhatsApp Notification Provider Configuration
# Supported values: mock, meta
WHATSAPP_PROVIDER=meta

# Meta WhatsApp Cloud API Configuration (Required when WHATSAPP_PROVIDER=meta)
# Obtain from Meta Developer Console → WhatsApp → API Setup
WHATSAPP_ACCESS_
WHATSAPP_PHONE_NUMBER_ID=1273683209166900
WHATSAPP_API_VERSION=v26.0

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=crowd_freelance
